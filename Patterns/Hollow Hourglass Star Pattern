import java.util.Scanner;
public class patterns {
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    System.out.print("Enter n:");
    int n = sc.nextInt();
for (int i = 0; i < n; i++) {
    for (int j = 0; j < n - i; j++) {
        System.out.print("*");
    }
    for (int spaces = 0; spaces < i * 2; spaces++) {
        System.out.print(" ");
    }
    for (int j = 0; j < n - i; j++) {
        System.out.print("*");
    }
    System.out.println();
}
for (int i = 1; i <= n; i++) {
    for (int j = 1; j <= i; j++) {
        System.out.print("*");
    }
    for (int spaces = 1; spaces <= 2 * (n - i); spaces++) {
        System.out.print(" ");
    }
    for (int j = 1; j <= i; j++) {
        System.out.print("*");
    }
    System.out.println();
}
