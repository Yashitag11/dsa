import java.util.Scanner;
public class patterns {
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    System.out.print("Enter n:");
    int n = sc.nextInt();
for(int i =1; i<=n; i++){
    // spaces
    for(int spaces = 1; spaces < n-i; spaces ++){
        System.out.print(" ");
    }
    // 1st half
    for(int j = i; j >=1; j--){
        System.out.print(j);
    }
    // 2nd half
    for(int j = 2; j <= i; j++) {
        System.out.print(j);
    }
    System.out.println();
}
