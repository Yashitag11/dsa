import java.util.Scanner;
public class patterns {
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    System.out.print("Enter n:");
    int n = sc.nextInt();
for(int i = 1; i<=n;i++){
      for(int j = 1; j <=i; j++){
        System.out.print(j);
    }
    for(int spaces = 1; spaces <= (n-i)*2; spaces ++){
        System.out.print(" ");
    }
      for(int j = i; j >=1; j--){
        System.out.print(j);
    }
    System.out.println();
}
